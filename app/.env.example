# Configuração pública do Agenda Psi (spec 18).
# Copie para .env. Tudo aqui é EXPO_PUBLIC_*, ou seja, vai embutido no bundle e
# é legível por quem abrir o IPA ou o APK — as chaves abaixo são públicas por
# design. Segredo de verdade (service_role, os do n8n e os das lojas) vive só
# nos secrets das Edge Functions, nunca aqui.

EXPO_PUBLIC_SUPABASE_URL=https://tocytpjtupbbxwgamtxq.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Analytics. Sem a chave o app roda normalmente e não emite evento.
EXPO_PUBLIC_VISAODEPRODUTO_KEY=ing_...
EXPO_PUBLIC_VISAODEPRODUTO_URL=https://api.visaodeproduto.com.br/functions/v1/ingest

# Não há chave de compra: a assinatura é direto nas lojas, pelo expo-iap.
