{
  "name": "agenda-psi-mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "Servidor MCP do Agenda Psi (conector para Claude e ChatGPT). Ver spec.md.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx --env-file=.env.local scripts/dev-server.ts",
    "dev:token": "tsx --env-file=.env.local scripts/dev-token.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "gen:types": "supabase gen types typescript --linked > src/database.types.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "2.0.4",
    "@modelcontextprotocol/server": "2.4.0",
    "@supabase/supabase-js": "2.119.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
