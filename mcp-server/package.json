{
  "name": "agenda-psi-mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "Servidor MCP do Agenda Psi (conector para Claude e ChatGPT). Ver spec.md.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run build:ui && tsx --env-file=.env.local scripts/dev-server.ts",
    "dev:token": "tsx --env-file=.env.local scripts/dev-token.ts",
    "dev:proxy": "tsx --env-file=.env.local scripts/dev-proxy.ts",
    "build:ui": "FORM=expense vite build && tsx scripts/embed-ui.ts",
    "build:site": "vite build --config vite.site.config.ts",
    "pretest": "npm run -s build:ui",
    "test": "vitest run",
    "pretypecheck": "npm run -s build:ui",
    "typecheck": "tsc --noEmit",
    "build": "npm run build:ui && npm run build:site && tsc -p tsconfig.build.json",
    "gen:types": "supabase gen types typescript --linked > src/database.types.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "2.0.4",
    "@modelcontextprotocol/server": "2.4.0",
    "@supabase/supabase-js": "2.119.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "5.1.0"
  }
}
