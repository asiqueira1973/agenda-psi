# Copie para .env.local (fora do git) e preencha. Seção 18 do spec.

# Públicas por design: as mesmas EXPO_PUBLIC_* do app.
SUPABASE_URL=https://tocytpjtupbbxwgamtxq.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# URL que a pessoa digita no conector; local usa a porta do `npm run dev`.
MCP_PUBLIC_URL=http://localhost:3333/mcp

# Só local: aceita o token do `npm run dev:token`, que não tem client_id (8.1.3).
# NUNCA cadastrar na Vercel.
MCP_DEV_ALLOW_SESSION_TOKEN=1

# Conta de teste dedicada (seção 22). Nunca a conta pessoal nem a de usuários reais.
TEST_EMAIL=
TEST_PASSWORD=
